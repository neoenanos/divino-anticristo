---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { render } from 'astro:content';

const biblio = await getEntry('docs','biblio')

if(!biblio){
  throw biblio
}

const {Content} = await render(biblio)

---

<BaseLayout title="Bibliografía">
  <article class="index-content framed">
    <Content>
  </article>
</BaseLayout>