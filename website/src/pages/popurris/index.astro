---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('popurris'))
  .filter(post => !post.data.draft)
  .sort((a, b) => a.data.p_title.localeCompare(b.data.p_title));
---

<BaseLayout title="Posts">
  <div>
    <h1 class="posts-title">Popurristísimos</h1>
    <p>
      Aquí podras encontrar los textos tipeados del Divino Anticristo.
    </p>
    <p>
      Puedes también leer (y corregir 🙄) las transcripciones con IA aún no verificadas en la <a href="https://github.com/neoenanos/divino-anticristo/tree/main/popurris/AI">carpeta IA</a>
    </p>
    <p>
      O bajar los <a href="https://github.com/carafelix/divino-anticristo">PDFs escaneados en el repositorio</a>.
      O nuestro compilado <a href="https://github.com/neoenanos/divino-anticristo/releases">ePub o PDF</a></p>
  </div>
  <hr>
  <div class="posts">
    {posts.length === 0 ? (
      <p>Nada todavía</p>
    ) : (
      posts.map((post) => <PostCard post={post} tipo={'popurris'} />)
    )}
  </div>
</BaseLayout>

<style>
  .posts-title {
    position: relative;
    color: var(--accent);
    margin-top: 0 !important;
    margin-bottom: 0 !important;
    padding-bottom: 15px;
    border-bottom: 3px dotted var(--accent);
  }
  
  .posts-title::after {
    content: "";
    position: absolute;
    bottom: 2px;
    display: block;
    width: 100%;
    border-bottom: 3px dotted var(--accent);
  }
</style>