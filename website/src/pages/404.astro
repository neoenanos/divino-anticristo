---
import BaseLayout from '../layouts/BaseLayout.astro';
const missingBackButtonLabel = "Back to home page";
const base = '/';
// const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---

<BaseLayout title="404 - Página no encontrada">
  <div class="page">
    <h1>404 — ¿No leíste acaso el manual IBM 360?</h1>
      <p>
        ¿Estan escuchando que busco una tipiquísima y me quiero casar con los bomberos?
        <br>
        ¿Estoy pensando que no encuentran lo que buscandísimo?
      </p>
      <div>
        <a href={base} class="button inline">
          <span class="button__text">{missingBackButtonLabel} →</span>
        </a>
      </div>
  </div>
</BaseLayout>

<style>
  .page {
    max-width: 760px;
    margin: 0 auto;
  }
</style>