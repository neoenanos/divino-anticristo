---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { render } from 'astro:content';

const colabora = await getEntry('docs','colabora')

if(!colabora){
  throw colabora
}

const { Content } = await render(colabora)

---

<BaseLayout title="Colabora">
  <article class="index-content framed">
    <Content>
  </article>
</BaseLayout>