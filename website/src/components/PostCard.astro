---
import { type CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import { Image } from 'astro:assets';
import { getPostDescription } from '../utils';

const images = import.meta.glob('/src/assets/*.{png,jpg,jpeg,svg}', { eager: true }) as Record<string, { default: any }>;

export interface Props {
  post: CollectionEntry<'popurris'> | CollectionEntry<'posts'>;
  tipo: string
}

const { post, tipo } = Astro.props;
const base = '/'
const slug = String(post.data?.slug || post.id).replace(/\.[^/.]+$/, '');
const postUrl = post.data.externalLink || `${base}${tipo}/${slug}/`;
const isExternal = !!post.data.externalLink;

function getPostImage(filename: string | undefined) {
  if (!filename) return null;
  const key = `/src/assets/${filename.replace(/^\//, '')}`;
  return images[key]?.default || null;
}

const imageImport = getPostImage(post.data.image);


const description = getPostDescription(post, 20)
---

<article class="post on-list">
  <h2 class="post-title">
    <a href={postUrl} target={isExternal ? "_blank" : undefined} rel={isExternal ? "noopener" : undefined}>
      {post.data.p_title}
    </a>
  </h2>
  {
    (post.data.pubDate || post.data.author) &&<div class="post-meta">
      {
        post.data.pubDate && <time class="post-date">
          <FormattedDate date={post.data.pubDate} />
        </time>
      }
      {post.data.author && (
        <span class="post-author">{post.data.author}</span>
      )}
    </div>
  }
  {post.data.tags && post.data.tags.length > 0 && (
    <span class="post-tags">
      {post.data.tags.map((tag : string) => (
          <a href={`${base}tags/${tag}/`}>{tag}</a>
      ))}
    </span>
  )}
  {post.data.image && (
    <figure class="post-cover">
      {imageImport ? (
        <Image src={imageImport} alt={post.data.p_title} />
      ) : (
        <img src={post.data.image} alt={post.data.p_title} />
      )}
    </figure>
  )}
  <div class="post-content">
    { description }
  </div>
  <div>
    <a href={postUrl} class="read-more button inline" target={isExternal ? "_blank" : undefined} rel={isExternal ? "noopener" : undefined}>
      [Leer más]
    </a>
  </div>
</article>